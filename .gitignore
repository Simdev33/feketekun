# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# forrásanyag, ami nem kerül a repóba (magánszemélyek profil-képernyőképei, aláírt FB-URL-ek, munkalapok)
/source-assets/fb/01_*
/source-assets/fb/02_*
/source-assets/fb/data.json
/source-assets/sheet*.jpg
/source-assets/c0.jpg
